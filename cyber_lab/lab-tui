menu_help() {
    local tmp_help
    tmp_help=$(mktemp "${TMPDIR:-/tmp}/cyberlab_help_XXXXXX.txt")
    cat <<'EOF' >"$tmp_help"
================================================================================
                    CYBERLAB TUI // USER GUIDE & KEYBINDINGS
================================================================================

1. VIM & ARROW KEYBOARD NAVIGATION
--------------------------------------------------------------------------------
   Key               Action
   ---               ------
   j / Down Arrow    Move selection down one line
   k / Up Arrow      Move selection up one line
   g / Home          Jump to first item in menu/checklist
   G / End           Jump to last item in menu/checklist
   h / Left Arrow    Navigate to previous button/field
   l / Right Arrow   Navigate to next button/field
   Tab               Cycle through active buttons / fields
   Space             Toggle item state in checklists (Multi-select)
   Enter             Activate button or select menu item
   Esc / Cancel      Return to previous screen or exit dialog

2. MENU MODULE OVERVIEW
--------------------------------------------------------------------------------
   * Browse Labs by Category:
     Drill down into 10 structured domains covering 800+ offensive, defensive,
     cloud, Kubernetes, DevSecOps, and exploit writing labs.

   * Active / Running Labs Dashboard:
     Instant list of all active CyberLab compose projects and containers.
     Jump straight into shell, view logs, or stop containers.

   * Search & Filter Labs:
     Real-time case-insensitive keyword search across shortcut keys, CVEs,
     ports, and descriptions.

   * Security & Tooling Suite:
     Quick access to dedicated red team and blue team platforms:
     Sliver C2, Caldera, Suricata NIDS, Zeek NSM, Snort IDS, DefectDojo,
     MISP, Cowrie Honeypot, REMnux Malware Analysis, and DFIR Volatility.

   * Bulk Operations:
     Select multiple targets using interactive checkboxes (with ALL / NONE)
     and perform batch Start, Stop, or Image Pulls with live progress gauge.

   * Global Management:
     Global lifecycle actions including real-time inspection of running Docker
     containers (`docker ps`), one-click shutdown of all CyberLab containers,
     disk usage analysis, network pruning, and stats snapshots.

3. INTERACTIVE SHELL SESSIONS
--------------------------------------------------------------------------------
   Selecting 'Connect to Shell' on any running lab will pause the TUI and attach
   an interactive pseudo-terminal (/bin/bash or /bin/sh) directly to the container.
   To return to CyberLab TUI, simply type:
       exit
   or press:
       Ctrl + D

4. PORTS & NETWORKING
--------------------------------------------------------------------------------
   Each lab binds its published ports to the host interface according to its
   docker-compose configuration. The port details are displayed on the lab detail
   screen and list items (e.g. Port 8080, Port 3000, Host Mode).

================================================================================
EOF
    ui_textbox "CyberLab TUI // Shortcuts & Guide" "$tmp_help"
    rm -f "$tmp_help" 2>/dev/null || true
}

# ------------------------------------------------------------------------------
# Main Application Loop
# ------------------------------------------------------------------------------

main_menu() {
    local default_choice="browse"
    while true; do
        refresh_running_labs
        local running_keys=("${!RUNNING_MAP[@]}")
        local running_count=${#running_keys[@]}
        local total_count=${#ALL_LAB_KEYS[@]}

        local status_str="[SYSTEM IDLE]"
        if [[ "$running_count" -gt 0 ]]; then
            status_str="[ACTIVE: ${running_count} LABS RUNNING]"
        fi

        local prompt_str="CyberLab Orchestrator | Total Catalog: ${total_count} Labs | ${status_str}\nNavigate: [j/k or ↑/↓] | Select: [Enter] | Switch: [Tab]"

        local -a main_items=(
            "browse"    "Browse Labs by Category (10 Domains, 800+ Labs)"
            "dashboard" "Active / Running Labs Dashboard (${running_count} Active)"
            "search"    "Search & Filter Labs (CVE, Port, Keyword)"
            "tools"     "Security & Tooling Suite (C2, SIEM, SOC, IDS)"
            "bulk"      "Bulk Operations (Multi-select Checklist)"
            "global"    "Global Management (Stop All, Disk Usage, Cleanup)"
            "help"      "Keyboard Shortcuts & Architecture Guide"
            "exit"      "Exit CyberLab TUI"
        )

        local choice
        choice=$(ui_menu "CyberLab v2.5 // TUI Control Center" "$prompt_str" "$default_choice" "${main_items[@]}") || break
        default_choice="$choice"

        case "$choice" in
        browse)    menu_browse_categories ;;
        dashboard) menu_dashboard ;;
        search)    menu_search ;;
        tools)     menu_tools ;;
        bulk)      menu_bulk ;;
        global)    menu_global ;;
        help)      menu_help ;;
        exit | "") break ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# Entrypoint
# ------------------------------------------------------------------------------

main() {
    case "${1:-}" in
    -h | --help)
        echo "CyberLab TUI - Terminal User Interface for CyberLab"
        echo "Usage: ./lab-tui [options]"
        echo ""
        echo "Options:"
        echo "  -r, --reload     Force rebuild of the lab catalog cache"
        echo "  -h, --help       Show this help message"
        echo "  -v, --version    Show version information"
        exit 0
        ;;
    -r | --reload | --rebuild-cache)
        echo "Rebuilding CyberLab catalog cache from lab script..."
        core_load_labs "" 1
        echo "Cache rebuilt successfully (${#ALL_LAB_KEYS[@]} labs indexed)."
        exit 0
        ;;
    -v | --version)
        echo "CyberLab TUI v2.5 (Pure Bash / dialog engine)"
        exit 0
        ;;
    esac

    # Check and auto-install required dependencies (dialog, tput, etc.)
    ui_ensure_dependencies

    ui_init
    if [[ "$UI_TOOL" == "none" ]]; then
        echo "Error: Neither 'dialog' nor 'whiptail' is installed or could be auto-installed on your system." >&2
        echo "Please install dialog manually: sudo apt-get update && sudo apt-get install -y dialog" >&2
        exit 1
    fi

    # Initialize catalog
    core_load_labs ""

    # Run main TUI
    main_menu

    ui_cleanup
    clear
    echo "CyberLab TUI session closed. Goodbye!"
}

main "$@"
