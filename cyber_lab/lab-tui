#!/usr/bin/env bash
# ==============================================================================
# CyberLab v2.5 - Professional TUI Workflow & Lab Controller
# Archinstall / Post-Install Style Management Interface
# ==============================================================================

set -o pipefail

# Determine base paths with fallback
CYBERLAB_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || echo "")"
if [[ -z "$CYBERLAB_ROOT" || ! -d "${CYBERLAB_ROOT}/lib_tui" ]]; then
    CYBERLAB_ROOT="/home/aadish/Documents/Github/lab/cyber_lab"
fi
LIB_DIR="${CYBERLAB_ROOT}/lib_tui"

# Source UI and Core modules
if [[ ! -f "${LIB_DIR}/ui.sh" || ! -f "${LIB_DIR}/core.sh" ]]; then
    echo "Error: CyberLab TUI libraries not found in ${LIB_DIR}" >&2
    exit 1
fi

# shellcheck source=lib_tui/ui.sh
source "${LIB_DIR}/ui.sh"
# shellcheck source=lib_tui/core.sh
source "${LIB_DIR}/core.sh"

# Signal trap for graceful cleanup and terminal restoration
trap 'ui_cleanup; exit 0' EXIT INT TERM

# Global state
declare -gA RUNNING_MAP=()

# ------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------

refresh_running_labs() {
    RUNNING_MAP=()
    local lab_key
    while IFS= read -r lab_key; do
        [[ -n "$lab_key" ]] && RUNNING_MAP["$lab_key"]=1
    done < <(core_get_running_labs)
}

# ------------------------------------------------------------------------------
# Lab Task Execution (Interactive Live Output)
# ------------------------------------------------------------------------------

run_lab_task() {
    local key="$1"
    local action="$2" # start, stop, restart, pull
    local title="$3"
    local path desc port cat cat_title rel_path
    path=$(get_lab_path "$key")
    desc=$(get_lab_desc "$key")
    port=$(get_lab_port "$key")
    cat=$(get_lab_category "$key")
    cat_title=$(core_get_category_title "$cat")
    rel_path="${path#"${CYBERLAB_ROOT}"/}"

    # Clear terminal buffer and restore terminal mode
    clear
    ui_restore_cursor
    if command -v stty >/dev/null 2>&1; then
        stty sane 2>/dev/null || true
        stty echo 2>/dev/null || true
    fi

    echo -e "\033[1;36m========================================================================\033[0m"
    echo -e "\033[1;32m[*] CyberLab Action  :\033[0m \033[1m${title}\033[0m"
    echo -e "\033[1;34m[*] Target Lab       :\033[0m ${key}"
    echo -e "\033[1;34m[*] Category         :\033[0m ${cat_title}"
    echo -e "\033[1;34m[*] Path             :\033[0m ${rel_path}"
    echo -e "\033[1;34m[*] Access / Port    :\033[0m ${port:-None / Internal}"
    echo -e "\033[1;36m========================================================================\033[0m"
    echo ""

    local start_time exit_code=0
    start_time=$(date +%s)

    case "$action" in
    start)
        echo -e "\033[0;33m==> Executing: docker compose up -d\033[0m\n"
        (cd "$path" && docker compose up -d) || exit_code=$?
        ;;
    stop)
        echo -e "\033[0;33m==> Executing: docker compose down\033[0m\n"
        (cd "$path" && docker compose down) || exit_code=$?
        ;;
    restart)
        echo -e "\033[0;33m==> Executing: docker compose restart\033[0m\n"
        (cd "$path" && docker compose restart) || exit_code=$?
        ;;
    pull)
        echo -e "\033[0;33m==> Executing: docker compose pull\033[0m\n"
        (cd "$path" && docker compose pull) || exit_code=$?
        ;;
    esac

    local duration=$(( $(date +%s) - start_time ))
    echo ""
    echo -e "\033[1;36m------------------------------------------------------------------------\033[0m"
    if [[ "$exit_code" -eq 0 ]]; then
        echo -e "\033[1;32m[✓] ${title} finished successfully in ${duration}s.\033[0m"
    else
        echo -e "\033[1;31m[✗] ${title} failed with exit code ${exit_code} (took ${duration}s).\033[0m"
    fi
    echo -e "\033[1;36m------------------------------------------------------------------------\033[0m"
    echo ""
    read -rp "Press [ENTER] to return to CyberLab TUI..." _ </dev/tty || true
    clear
    return "$exit_code"
}

# ------------------------------------------------------------------------------
# Lab Detail / Action Menu
# ------------------------------------------------------------------------------

show_lab_action_menu() {
    local key="$1"
    local default_action="start"

    while true; do
        local path desc port cat cat_title status_badge status_text rel_path
        path=$(get_lab_path "$key")
        desc=$(get_lab_desc "$key")
        port=$(get_lab_port "$key")
        cat=$(get_lab_category "$key")
        cat_title=$(core_get_category_title "$cat")
        rel_path="${path#"${CYBERLAB_ROOT}"/}"

        if core_is_running "$key"; then
            status_badge="[RUNNING]"
            status_text="RUNNING (Container active)"
            [[ "$default_action" == "start" ]] && default_action="shell"
        else
            status_badge="[STOPPED]"
            status_text="STOPPED (Containers offline)"
            [[ "$default_action" == "shell" || "$default_action" == "stop" ]] && default_action="start"
        fi

        local prompt_info
        prompt_info="Target   : ${key}\nStatus   : ${status_text}\nCategory : ${cat_title}\nAccess   : ${port:-None / Internal}\nPath     : ${rel_path}\nInfo     : ${desc}\n\nSelect an operation:"

        local -a actions=(
            "start"   "Start Lab (docker compose up -d)"
            "stop"    "Stop Lab (docker compose down)"
            "restart" "Restart Lab (docker compose restart)"
            "shell"   "Interactive Shell (Connect to primary service)"
            "logs"    "View Container Logs (Tail 150 lines)"
            "compose" "View docker-compose.yml"
            "readme"  "View Lab Documentation (README.md)"
            "pull"    "Pull Container Images"
            "back"    "<-- Return to Previous Menu"
        )

        local action
        action=$(ui_menu "CyberLab // ${key} ${status_badge}" "$prompt_info" "$default_action" "${actions[@]}") || break
        default_action="$action"

        case "$action" in
        start)
            if run_lab_task "$key" "start" "Start Lab"; then
                default_action="shell"
            fi
            ;;
        stop)
            if run_lab_task "$key" "stop" "Stop Lab"; then
                default_action="start"
            fi
            ;;
        restart)
            run_lab_task "$key" "restart" "Restart Lab"
            ;;
        shell)
            if ! core_is_running "$key"; then
                if ui_yesno "Lab Offline" "Lab '${key}' is currently stopped.\n\nWould you like to start it now before opening a shell?"; then
                    if ! run_lab_task "$key" "start" "Start Lab for Interactive Shell"; then
                        continue
                    fi
                else
                    continue
                fi
            fi
            clear
            ui_restore_cursor
            core_shell_lab "$key"
            clear
            ;;
        logs)
            local tmp_log
            tmp_log=$(mktemp "${TMPDIR:-/tmp}/cyberlab_logs_XXXXXX.log")
            core_get_logs "$key" 150 >"$tmp_log" 2>&1 || true
            if [[ ! -s "$tmp_log" ]]; then
                echo "No log records found for ${key} (is the container running?)." >"$tmp_log"
            fi
            ui_textbox "Container Logs: ${key} (Last 150 Lines)" "$tmp_log"
            rm -f "$tmp_log" 2>/dev/null || true
            ;;
        compose)
            local tmp_file
            tmp_file=$(mktemp "${TMPDIR:-/tmp}/cyberlab_compose_XXXXXX.yml")
            if core_get_compose_content "$key" >"$tmp_file" && [[ -s "$tmp_file" ]]; then
                ui_textbox "docker-compose.yml: ${key}" "$tmp_file"
            else
                ui_msg "Notice" "No docker-compose.yml file found for ${key}."
            fi
            rm -f "$tmp_file" 2>/dev/null || true
            ;;
        readme)
            local tmp_file
            tmp_file=$(mktemp "${TMPDIR:-/tmp}/cyberlab_readme_XXXXXX.md")
            if core_get_readme_content "$key" >"$tmp_file" && [[ -s "$tmp_file" ]]; then
                ui_textbox "Documentation: ${key}" "$tmp_file"
            else
                ui_msg "Notice" "No README.md documentation file found for ${key}."
            fi
            rm -f "$tmp_file" 2>/dev/null || true
            ;;
        pull)
            run_lab_task "$key" "pull" "Pull Container Images"
            ;;
        back | "")
            break
            ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# 1. Browse Labs by Category
# ------------------------------------------------------------------------------

show_category_labs() {
    local cat="$1"
    local cat_title
    cat_title=$(core_get_category_title "$cat")
    local last_selected=""

    while true; do
        refresh_running_labs
        local raw_labs
        raw_labs=$(core_get_labs_by_category "$cat")
        if [[ -z "$raw_labs" ]]; then
            ui_msg "Empty Category" "No labs registered under '${cat_title}'."
            return 0
        fi

        local -a menu_items=(
            ".." "<-- Back to Categories"
        )

        local k desc port badge
        while IFS= read -r k; do
            [[ -z "$k" ]] && continue
            desc=$(get_lab_desc "$k")
            port=$(get_lab_port "$k")
            if [[ -n "${RUNNING_MAP[$k]:-}" ]]; then
                badge="[RUNNING]"
            else
                badge="[STOPPED]"
            fi
            if [[ -n "$port" ]]; then
                menu_items+=("$k" "${badge} ${port} | ${desc}")
            else
                menu_items+=("$k" "${badge} ${desc}")
            fi
        done <<<"$raw_labs"

        local choice
        choice=$(ui_menu "Category: ${cat_title}" "Select a lab to view details and launch actions:" "$last_selected" "${menu_items[@]}") || break

        if [[ "$choice" == ".." || -z "$choice" ]]; then
            break
        fi

        last_selected="$choice"
        show_lab_action_menu "$choice"
    done
}

menu_browse_categories() {
    local last_cat=""
    while true; do
        local -a cat_items=(
            ".." "<-- Back to Main Menu"
        )
        for c in "${CATEGORIES[@]}"; do
            local title
            title=$(core_get_category_title "$c")
            local raw_labs count=0
            raw_labs=$(core_get_labs_by_category "$c")
            if [[ -n "$raw_labs" ]]; then
                count=$(grep -c . <<<"$raw_labs" || echo 0)
            fi
            cat_items+=("$c" "${title} (${count} labs)")
        done

        local sel_cat
        sel_cat=$(ui_menu "Browse Labs by Category" "Select a category to inspect lab environments:" "$last_cat" "${cat_items[@]}") || break

        if [[ "$sel_cat" == ".." || -z "$sel_cat" ]]; then
            break
        fi

        last_cat="$sel_cat"
        show_category_labs "$sel_cat"
    done
}

# ------------------------------------------------------------------------------
# 2. Active / Running Labs Dashboard
# ------------------------------------------------------------------------------

menu_dashboard() {
    local last_selected=""
    while true; do
        refresh_running_labs
        local running_keys=("${!RUNNING_MAP[@]}")

        if [[ ${#running_keys[@]} -eq 0 ]]; then
            ui_msg "Running Labs Dashboard" "No active CyberLab containers are currently running.\n\nYou can launch labs via 'Browse Labs by Category', 'Search & Filter', or 'Security & Tooling Suite'."
            return 0
        fi

        local -a menu_items=(
            ".." "<-- Back to Main Menu"
        )

        local sorted_keys=()
        mapfile -t sorted_keys < <(printf "%s\n" "${running_keys[@]}" | sort)

        for k in "${sorted_keys[@]}"; do
            local desc port
            desc=$(get_lab_desc "$k")
            port=$(get_lab_port "$k")
            if [[ -n "$port" ]]; then
                menu_items+=("$k" "[RUNNING] ${port} | ${desc}")
            else
                menu_items+=("$k" "[RUNNING] ${desc}")
            fi
        done

        local choice
        choice=$(ui_menu "Active / Running Labs Dashboard" "Currently running CyberLab containers (${#sorted_keys[@]} active):" "$last_selected" "${menu_items[@]}") || break

        if [[ "$choice" == ".." || -z "$choice" ]]; then
            break
        fi

        last_selected="$choice"
        show_lab_action_menu "$choice"
    done
}

# ------------------------------------------------------------------------------
# 3. Search & Filter Labs
# ------------------------------------------------------------------------------

menu_search() {
    local last_query=""
    while true; do
        local query
        query=$(ui_input "Search & Filter Labs" "Search by shortcut key, CVE, port, or keyword:" "$last_query") || break

        # Strip leading/trailing whitespace
        query="${query#"${query%%[![:space:]]*}"}"
        query="${query%"${query##*[![:space:]]}"}"

        if [[ -z "$query" ]]; then
            break
        fi
        last_query="$query"

        # Find matching labs
        local -a matches=()
        shopt -s nocasematch
        for k in "${ALL_LAB_KEYS[@]}"; do
            local val="${LABS[$k]}"
            if [[ "$k" =~ $query || "$val" =~ $query ]]; then
                matches+=("$k")
            fi
        done
        shopt -u nocasematch

        if [[ ${#matches[@]} -eq 0 ]]; then
            ui_msg "Search Results" "No labs found matching query: '${query}'\n\nTry searching for CVE (e.g. 'cve-2024'), tool ('sliver', 'suricata'), or port ('8080')."
            continue
        fi

        local last_sel=""
        while true; do
            refresh_running_labs
            local -a menu_items=(
                ".." "<-- New Search / Back"
            )
            for k in "${matches[@]}"; do
                local desc port badge
                desc=$(get_lab_desc "$k")
                port=$(get_lab_port "$k")
                if [[ -n "${RUNNING_MAP[$k]:-}" ]]; then
                    badge="[RUNNING]"
                else
                    badge="[STOPPED]"
                fi
                if [[ -n "$port" ]]; then
                    menu_items+=("$k" "${badge} ${port} | ${desc}")
                else
                    menu_items+=("$k" "${badge} ${desc}")
                fi
            done

            local choice
            choice=$(ui_menu "Search Results (${#matches[@]} matches for '${query}')" "Select a matching lab to view details and launch actions:" "$last_sel" "${menu_items[@]}") || break

            if [[ "$choice" == ".." || -z "$choice" ]]; then
                break
            fi

            last_sel="$choice"
            show_lab_action_menu "$choice"
        done
    done
}

