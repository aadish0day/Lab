# ------------------------------------------------------------------------------
# 5. Bulk Operations (Multi-select Checklist)
# ------------------------------------------------------------------------------

menu_bulk() {
    # 1. Choose Scope Category
    local -a cat_choices=(
        "all" "All Categories (800+ Labs)"
    )
    for c in "${CATEGORIES[@]}"; do
        local title count
        title=$(core_get_category_title "$c")
        local raw_labs
        raw_labs=$(core_get_labs_by_category "$c")
        count=$(grep -c . <<<"$raw_labs" || echo 0)
        cat_choices+=("$c" "${title} (${count} labs)")
    done
    cat_choices+=("back" "<-- Back to Main Menu")

    local sel_cat
    sel_cat=$(ui_menu "Bulk Operations // Select Scope" "Choose category of labs to operate on:" "all" "${cat_choices[@]}") || return 0
    [[ "$sel_cat" == "back" || -z "$sel_cat" ]] && return 0

    # 2. Choose Operation
    local -a op_choices=(
        "start" "Bulk Start (docker compose up -d)"
        "stop"  "Bulk Stop (docker compose down)"
        "pull"  "Bulk Pull Images (docker compose pull)"
        "back"  "<-- Back"
    )
    local sel_op
    sel_op=$(ui_menu "Bulk Operations // Select Action" "Select the bulk action to perform:" "start" "${op_choices[@]}") || return 0
    [[ "$sel_op" == "back" || -z "$sel_op" ]] && return 0

    # 3. Collect target labs
    local -a target_keys=()
    if [[ "$sel_cat" == "all" ]]; then
        target_keys=("${ALL_LAB_KEYS[@]}")
    else
        mapfile -t target_keys < <(core_get_labs_by_category "$sel_cat" | grep -v '^[[:space:]]*$')
    fi

    if [[ ${#target_keys[@]} -eq 0 ]]; then
        ui_msg "Bulk Operations" "No labs available in the selected scope."
        return 0
    fi

    # 4. Build checklist items
    local -a checklist_items=()
    for k in "${target_keys[@]}"; do
        local desc port
        desc=$(get_lab_desc "$k")
        port=$(get_lab_port "$k")
        checklist_items+=("$k" "${port:+$port | }${desc}" "OFF")
    done

    local cat_label
    if [[ "$sel_cat" == "all" ]]; then
        cat_label="All Categories"
    else
        cat_label=$(core_get_category_title "$sel_cat")
    fi

    local selected_raw
    selected_raw=$(ui_checklist "Bulk ${sel_op^^} // ${cat_label}" "Select targets (Space to toggle, 'ALL' / 'NONE' at top):" "${checklist_items[@]}") || return 0

    local -a selected_labs=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && selected_labs+=("$line")
    done <<<"$selected_raw"

    local total=${#selected_labs[@]}
    if [[ "$total" -eq 0 ]]; then
        ui_msg "Bulk Operations" "No labs were selected. Operation cancelled."
        return 0
    fi

    # 5. Confirm
    if ! ui_yesno "Confirm Bulk Operation" "Are you sure you want to perform '${sel_op^^}' on ${total} lab(s)?"; then
        return 0
    fi

    # 6. Execute with gauge progress and summary
    local tmp_summary
    tmp_summary=$(mktemp "${TMPDIR:-/tmp}/cyberlab_bulk_summary_XXXXXX.txt")
    {
        echo "=================================================================="
        echo "CyberLab Bulk ${sel_op^^} Summary Report"
        echo "Timestamp: $(date '+%Y-%m-%d %H:%M:%S')"
        echo "Total Selected: ${total}"
        echo "Scope: ${cat_label}"
        echo "=================================================================="
        echo ""
    } >"$tmp_summary"

    (
        for ((idx = 0; idx < total; idx++)); do
            local lab_k="${selected_labs[idx]}"
            local pct=$(((idx * 100) / total))
            echo "$pct"
            echo "XXX"
            echo "[$((idx + 1))/$total] Performing ${sel_op} on: ${lab_k}..."
            echo "XXX"

            local tmp_op_log
            tmp_op_log=$(mktemp "${TMPDIR:-/tmp}/cyberlab_bulk_op_XXXXXX.log")
            local ret=0
            case "$sel_op" in
            start) core_start_lab "$lab_k" "$tmp_op_log" || ret=$? ;;
            stop) core_stop_lab "$lab_k" "$tmp_op_log" || ret=$? ;;
            pull) core_pull_lab "$lab_k" "$tmp_op_log" || ret=$? ;;
            esac

            if [[ "$ret" -eq 0 ]]; then
                echo "[SUCCESS] ${lab_k}" >>"$tmp_summary"
            else
                {
                    echo "[FAILED ] ${lab_k} (Exit code ${ret})"
                    cat "$tmp_op_log"
                    echo "--------------------------------------------------"
                } >>"$tmp_summary"
            fi
            rm -f "$tmp_op_log" 2>/dev/null || true
        done
        echo "100"
        echo "XXX"
        echo "Bulk ${sel_op} completed successfully!"
        echo "XXX"
    ) | ui_gauge "Bulk ${sel_op^^} in Progress" "Executing bulk operation on ${total} labs..." 0

    ui_textbox "Bulk ${sel_op^^} Report" "$tmp_summary"
    rm -f "$tmp_summary" 2>/dev/null || true
}

# ------------------------------------------------------------------------------
# 6. Global Management
# ------------------------------------------------------------------------------

menu_global() {
    local default_choice="running"
    while true; do
        local -a global_items=(
            "running" "View Running Docker Containers (docker ps)"
            "stop_all" "Stop All CyberLab Containers Across Project"
            "disk_usage" "Docker Disk Usage (docker system df)"
            "stats" "Live Container Resource Usage (docker stats)"
            "prune_networks" "Clean Unused Networks & Build Cache"
            "back" "<-- Back to Main Menu"
        )

        local choice
        choice=$(ui_menu "Global CyberLab Management" "Perform global Docker infrastructure and lifecycle tasks:" "$default_choice" "${global_items[@]}") || break
        default_choice="$choice"

        case "$choice" in
        running)
            local tmp_log
            tmp_log=$(mktemp "${TMPDIR:-/tmp}/cyberlab_running_XXXXXX.log")
            {
                echo "================================================================================"
                echo "                     CURRENT RUNNING DOCKER CONTAINERS                          "
                echo "================================================================================"
                echo "Generated at: $(date '+%Y-%m-%d %H:%M:%S')"
                echo ""
                echo "--- [1. Active CyberLab Containers] ---"
                local cl_out
                cl_out=$(docker ps --filter "name=cyberlab_" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}\t{{.Image}}" 2>&1 || true)
                local cl_lines
                cl_lines=$(grep -c . <<<"$cl_out" 2>/dev/null || echo 0)
                if [[ "$cl_lines" -le 1 ]]; then
                    echo "No CyberLab containers currently running."
                else
                    echo "$cl_out"
                fi
                echo ""
                echo "--- [2. All Active Host Containers] ---"
                local sys_out
                sys_out=$(docker ps --format "table {{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Ports}}\t{{.Image}}" 2>&1 || true)
                local sys_lines
                sys_lines=$(grep -c . <<<"$sys_out" 2>/dev/null || echo 0)
                if [[ "$sys_lines" -le 1 ]]; then
                    echo "No running Docker containers detected on system."
                else
                    echo "$sys_out"
                fi
                echo ""
                echo "================================================================================"
            } >"$tmp_log"
            ui_textbox "Running Containers (docker ps)" "$tmp_log"
            rm -f "$tmp_log" 2>/dev/null || true
            ;;
        stop_all)
            if ui_yesno "Confirm Stop All" "Are you sure you want to shut down ALL running CyberLab containers across the entire repository?"; then
                clear
                ui_restore_cursor
                if command -v stty >/dev/null 2>&1; then
                    stty sane 2>/dev/null || true
                    stty echo 2>/dev/null || true
                fi
                echo -e "\033[1;36m========================================================================\033[0m"
                echo -e "\033[1;33m[*] Stopping ALL CyberLab containers...\033[0m"
                echo -e "\033[1;36m========================================================================\033[0m\n"
                core_stop_all
                echo ""
                read -rp "Press [ENTER] to return to CyberLab TUI..." _ </dev/tty || true
                clear
            fi
            ;;
        disk_usage)
            local tmp_log
            tmp_log=$(mktemp "${TMPDIR:-/tmp}/cyberlab_df_XXXXXX.log")
            docker system df >"$tmp_log" 2>&1 || echo "Error querying docker system df" >"$tmp_log"
            ui_textbox "Docker System Disk Usage" "$tmp_log"
            rm -f "$tmp_log" 2>/dev/null || true
            ;;
        stats)
            local tmp_log
            tmp_log=$(mktemp "${TMPDIR:-/tmp}/cyberlab_stats_XXXXXX.log")
            docker stats --no-stream --format "table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.NetIO}}\t{{.BlockIO}}" >"$tmp_log" 2>&1 || echo "Error querying docker stats" >"$tmp_log"
            ui_textbox "Container Resource Stats (Snapshot)" "$tmp_log"
            rm -f "$tmp_log" 2>/dev/null || true
            ;;
        prune_networks)
            if ui_yesno "Confirm Network & Cache Cleanup" "Prune unused docker networks and builder cache?\n(Active containers and images are not deleted)."; then
                clear
                ui_restore_cursor
                if command -v stty >/dev/null 2>&1; then
                    stty sane 2>/dev/null || true
                    stty echo 2>/dev/null || true
                fi
                echo -e "\033[1;36m========================================================================\033[0m"
                echo -e "\033[1;33m[*] Pruning unused docker networks and builder cache...\033[0m"
                echo -e "\033[1;36m========================================================================\033[0m\n"
                echo "==> Pruning unused docker networks..."
                docker network prune -f
                echo ""
                echo "==> Pruning docker builder cache..."
                docker builder prune -f
                echo ""
                read -rp "Press [ENTER] to return to CyberLab TUI..." _ </dev/tty || true
                clear
            fi
            ;;
        back | "")
            break
            ;;
        esac
    done
}

