print_help() {
  echo "================================================================="
  echo "   CyberLab CLI Manager"
  echo "================================================================="
  echo "Usage: ./lab <command> [lab_name]"
  echo ""
  echo "Commands:"
  echo "  list               List all available labs and shortcuts"
  echo "  start <name>       Start a specific lab"
  echo "  stop <name>        Stop a specific lab"
  echo "  restart <name>     Restart a specific lab"
  echo "  shell <name>       Open bash/sh inside the lab container"
  echo "  status             Show running containers and health"
  echo "  stop-all           Stop all running cyberlab containers"
  echo ""
  echo "Examples:"
  echo "  ./lab start juice-shop"
  echo "  ./lab start aws-localstack"
  echo "  ./lab start c2-sliver && ./lab shell c2-sliver"
  echo "  ./lab stop-all"
  echo "================================================================="
}

list_labs() {
  echo -e "\n--- [Available Labs & Shortcuts] ---\n"
  printf "%-26s | %-55s | %-20s\n" "SHORTCUT" "DESCRIPTION" "PORT / ACCESS"
  echo "--------------------------------------------------------------------------------------------------------------------------"
  for key in $(echo "${!LABS[@]}" | tr ' ' '\n' | sort); do
    IFS="|" read -r path desc port <<< "${LABS[$key]}"
    printf "%-26s | %-55s | %-20s\n" "$key" "$desc" "$port"
  done
  echo ""
}

get_lab_path() {
  local target="$1"
  if [[ -n "${LABS[$target]}" ]]; then
    IFS="|" read -r path desc port <<< "${LABS[$target]}"
    echo "$SCRIPT_DIR/$path"
  else
    echo ""
  fi
}

cmd="${1:-help}"
target="$2"

case "$cmd" in
  list)
    list_labs
    ;;
  start)
    if [[ -z "$target" ]]; then
      echo "Error: Missing lab name. Run './lab list' to see available labs."
      exit 1
    fi
    lab_path=$(get_lab_path "$target")
    if [[ -z "$lab_path" || ! -d "$lab_path" ]]; then
      echo "Error: Unknown lab '$target'. Run './lab list' to check names."
      exit 1
    fi
    echo " Starting lab: $target ($lab_path)..."
    cd "$lab_path"
    docker compose up -d
    echo " Lab '$target' is up! Check status with './lab status'."
    ;;
  stop)
    if [[ -z "$target" ]]; then
      echo "Error: Missing lab name."
      exit 1
    fi
    lab_path=$(get_lab_path "$target")
    if [[ -z "$lab_path" || ! -d "$lab_path" ]]; then
      echo "Error: Unknown lab '$target'."
      exit 1
    fi
    echo " Stopping lab: $target..."
    cd "$lab_path"
    docker compose down
    echo " Lab '$target' stopped."
    ;;
  restart)
    if [[ -z "$target" ]]; then
      echo "Error: Missing lab name."
      exit 1
    fi
    lab_path=$(get_lab_path "$target")
    cd "$lab_path"
    docker compose restart
    ;;
  shell)
    if [[ -z "$target" ]]; then
      echo "Error: Missing lab name."
      exit 1
    fi
    lab_path=$(get_lab_path "$target")
    cd "$lab_path"
    service_name=$(docker compose ps --services | head -n 1)
    if [[ -z "$service_name" ]]; then
      echo "Error: Lab is not running. Start it first: ./lab start $target"
      exit 1
    fi
    echo " Connecting to $service_name..."
    docker compose exec -it "$service_name" /bin/bash || docker compose exec -it "$service_name" /bin/sh
    ;;
  status)
    echo -e "\n--- [Running CyberLab Containers] ---\n"
    docker ps --filter "name=cyberlab_" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
    echo ""
    ;;
  stop-all)
    echo " Stopping all running cyberlab containers..."
    containers=$(docker ps -q --filter "name=cyberlab_")
    if [[ -n "$containers" ]]; then
      docker stop $containers
      echo " All cyberlab containers stopped."
    else
      echo "No cyberlab containers currently running."
    fi
    ;;
  help|*)
    print_help
    ;;
esac
