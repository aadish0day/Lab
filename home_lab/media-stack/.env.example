# ==============================================================================
# Media Stack VPN Configuration (Gluetun)
# ==============================================================================
# Copy this file to `.env` in the same directory:
#   cp .env.example .env
#
# Then fill in your VPN credentials and desired settings below.
# ==============================================================================

# VPN Provider Selection
# Options include: protonvpn, mullvad, nordvpn, surfshark, custom, ivpn, pia, etc.
# Full list: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=protonvpn

# VPN Protocol Type
# Recommended: wireguard (faster, lower overhead) or openvpn
VPN_TYPE=wireguard

# WireGuard Private Key
# Generated from your VPN provider account dashboard when creating a WireGuard configuration.
# For ProtonVPN: Account Settings -> Downloads -> WireGuard configuration -> Private key
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here

# ProtonVPN Free Tier Setting
# Set to 'on' if using ProtonVPN Free servers.
# Set to 'off' if you have a paid subscription.
VPN_FREE_ONLY=on

# VPN Server Country
# Common choices: Netherlands, United States, Japan, etc.
# For ProtonVPN free tier, servers are typically in Netherlands, United States, or Japan.
VPN_SERVER_COUNTRIES=Netherlands

# Optional Wireguard Configurations (Required by some providers, e.g. Mullvad / Custom):
# WIREGUARD_ADDRESSES=10.2.0.2/32
# WIREGUARD_PRESHARED_KEY=
