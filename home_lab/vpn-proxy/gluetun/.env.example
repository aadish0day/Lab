# ProtonVPN WireGuard private key.
#
# 1. Go to https://account.proton.me/u/0/vpn/WireGuard and generate a config
# (use a free-tier server; select "NAT-PMP / Port forwarding" only if needed).
# 2. Download the config file, copy the value on the PrivateKey= line.
# 3. cp .env.example .env, paste that value below.
#
# The key pair is shared, one private key works for all ProtonVPN servers.
WIREGUARD_PRIVATE_KEY=
